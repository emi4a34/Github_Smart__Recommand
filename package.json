{
  "name": "skill-hub",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"tsx watch server/index.ts\" \"vite\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node -e \"const fs=require('fs');process.exit(fs.existsSync('dist-server/server/index.js')?0:1)\" && node dist-server/server/index.js || tsx server/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.web.json",
    "compile": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@hono/node-server": "2.1.6",
    "hono": "4.13.16",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "skills": "1.7.6",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "concurrently": "10.0.6",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
